#!/usr/bin/env python3
"""Run the lazy Polars analysis for a generated dataset."""

import argparse
from pathlib import Path

from benchmark import process_polars


def main() -> None:
	parser = argparse.ArgumentParser()
	parser.add_argument("dataset", type=Path)
	parser.add_argument("--format", choices=("csv", "parquet"), required=True, dest="file_type")
	args = parser.parse_args()
	print(process_polars(args.dataset, args.file_type).head(20))


if __name__ == "__main__":
	main()

